# Copy to .env for local use, and set the same keys in Netlify's UI
# (Site configuration -> Environment variables) for deploys.

# --- Client-side (must be VITE_ prefixed to reach the browser) ---

# Cloudflare Web Analytics beacon token.
# Get it at: Cloudflare dashboard -> Analytics & Logs -> Web Analytics ->
# Add a site (wiseandpure.com). Copy the token out of the snippet it shows.
# Not a secret -- it is visible in the page source. Left unset, the beacon
# simply is not rendered, so local dev and forks never report real traffic.
VITE_CF_BEACON_TOKEN=

# --- Server-side (Netlify functions only, never exposed to the browser) ---

# Brevo transactional email API key, used by netlify/functions/send-email.js
BREVO_API_KEY=

# Where contact-form lead notifications are delivered
RECEIVER_EMAIL=
