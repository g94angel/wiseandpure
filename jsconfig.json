{
  "include": [
    "src/**/*",
    "vite.config.mjs",
    "react-router.config.js",
    "scripts/**/*",
    ".react-router/types/**/*.ts"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "rootDirs": [".", "./.react-router/types"]
  }
}
